    "이 과정을 통해 정확한 암기 상태를 판단할 수 있어요!" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This helps you accurately track which words you've memorized!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この手順で、正確な暗記状況を把握できます!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过这个过程，可以准确判断你的记忆情况！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過這個過程，可以準確判斷你的記憶狀況！"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Así podrás saber con precisión qué palabras has memorizado!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela vous permet de savoir précisément quels mots vous avez mémorisés !"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So erkennst du genau, welche Wörter du dir wirklich gemerkt hast!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assim você sabe com precisão quais palavras já memorizou!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhờ đó bạn biết chính xác mình đã thuộc những từ nào!"
