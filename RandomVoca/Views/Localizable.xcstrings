    "뜻을 확인 후 정말로 알고 있는 단어라면 아는 단어로 체크합니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After checking the meaning, mark it as known if you really knew it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "意味を確認して、本当に知っていた単語なら「知っている」にチェックします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看释义后，如果确实认识，就标记为认识。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看釋義後，如果確實認識，就標記為認識。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después de ver el significado, márcala como sabida si de verdad la sabías."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après avoir vu la signification, marquez le mot comme connu si vous le connaissiez vraiment."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du das Wort nach dem Prüfen der Bedeutung wirklich kanntest, markiere es als bekannt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois de ver o significado, marque como conhecida se você realmente sabia."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau khi xem nghĩa, nếu thật sự biết thì đánh dấu là đã biết."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah melihat artinya, tandai sebagai diketahui jika Anda benar-benar tahu."
          }
        },
