          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Apple Account enthält bereits Daten"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua Conta Apple já tem dados"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tài khoản Apple đã có dữ liệu"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akun Apple Anda sudah memiliki data"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บัญชี Apple มีข้อมูลอยู่แล้ว"
          }
        }
      }
    },
    "Apple 계정에 저장된 데이터로 덮어쓰시겠습니까?\n※ 현재 익명 계정 데이터는 사라집니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replace with the data saved in your Apple Account?\n※ Data in the current anonymous account will be lost."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple アカウントに保存されたデータで上書きしますか?\n※ 現在の匿名アカウントのデータは失われます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要用 Apple 账户中保存的数据覆盖吗？\n※ 当前匿名账户的数据将会丢失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要以 Apple 帳號中儲存的資料覆寫嗎？\n※ 目前匿名帳號的資料將會遺失。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quieres reemplazarlos con los datos guardados en tu cuenta de Apple?\n※ Se perderán los datos de la cuenta anónima actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplacer par les données enregistrées dans votre compte Apple ?\n※ Les données du compte anonyme actuel seront perdues."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit den in deinem Apple Account gespeicherten Daten überschreiben?\n※ Die Daten des aktuellen anonymen Kontos gehen verloren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substituir pelos dados salvos na sua Conta Apple?\n※ Os dados da conta anônima atual serão perdidos."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi đè bằng dữ liệu đã lưu trong Tài khoản Apple?\n※ Dữ liệu của tài khoản ẩn danh hiện tại sẽ bị mất."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timpa dengan data yang tersimpan di Akun Apple Anda?\n※ Data di akun anonim saat ini akan hilang."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้องการเขียนทับด้วยข้อมูลที่บันทึกไว้ในบัญชี Apple หรือไม่\n※ ข้อมูลในบัญชีแบบไม่ระบุตัวตนปัจจุบันจะหายไป"
          }
        }
      }
    },
